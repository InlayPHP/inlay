{
    "name": "inlayphp/inlay",
    "description": "PHP-first administration panels and UI components for Laravel and Inertia.",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/support": "^12.0",
        "inlayphp/actions": "dev-main",
        "inlayphp/authorization": "dev-main",
        "inlayphp/core": "dev-main",
        "inlayphp/design": "dev-main",
        "inlayphp/forms": "dev-main",
        "inlayphp/infolists": "dev-main",
        "inlayphp/notifications": "dev-main",
        "inlayphp/panels": "dev-main",
        "inlayphp/resources": "dev-main",
        "inlayphp/schemas": "dev-main",
        "inlayphp/support": "dev-main",
        "inlayphp/tables": "dev-main",
        "inlayphp/theme": "dev-main",
        "inlayphp/validation": "dev-main",
        "inlayphp/widgets": "dev-main"
    },
    "require-dev": {
        "inlayphp/authorization-spatie": "dev-main",
        "inlayphp/imports": "dev-main",
        "inlayphp/media": "dev-main",
        "inlayphp/media-manager": "dev-main",
        "inlayphp/media-spatie": "dev-main",
        "inlayphp/permission-manager": "dev-main",
        "inlayphp/tables-xlsx": "dev-main",
        "inlayphp/two-factor-authentication": "dev-main",
        "phiki/phiki": "^2.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "inlayphp/authorization-spatie": "Synchronize Inlay abilities with Spatie Laravel Permission.",
        "inlayphp/imports": "Add validated, fault-isolated import workflows.",
        "inlayphp/media": "Add the storage-neutral media catalog without a panel UI.",
        "inlayphp/media-manager": "Add the official authorized panel media browser and picker.",
        "inlayphp/media-spatie": "Bridge the Inlay media catalog with Spatie Media Library.",
        "inlayphp/permission-manager": "Add role, permission, assignment, and access-audit screens.",
        "inlayphp/tables-xlsx": "Add an optional PhpSpreadsheet XLSX export driver for Inlay tables.",
        "inlayphp/two-factor-authentication": "Add optional TOTP, recovery-code, enrollment, and panel challenge flows."
    },
    "autoload": {
        "psr-4": {
            "Inlay\\Installer\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Inlay\\Installer\\InlayServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "find src packages tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
