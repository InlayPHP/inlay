{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/blank-react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "inertiajs/inertia-laravel": "^3.0",
        "inlayphp/actions": "dev-main",
        "inlayphp/authorization": "dev-main",
        "inlayphp/authorization-spatie": "dev-main",
        "inlayphp/core": "dev-main",
        "inlayphp/design": "dev-main",
        "inlayphp/forms": "dev-main",
        "inlayphp/imports": "dev-main",
        "inlayphp/infolists": "dev-main",
        "inlayphp/notifications": "dev-main",
        "inlayphp/media": "dev-main",
        "inlayphp/media-manager": "dev-main",
        "inlayphp/panels": "dev-main",
        "inlayphp/permission-manager": "dev-main",
        "inlayphp/resources": "dev-main",
        "inlayphp/schemas": "dev-main",
        "inlayphp/support": "dev-main",
        "inlayphp/tables": "dev-main",
        "inlayphp/tables-xlsx": "dev-main",
        "inlayphp/theme": "dev-main",
        "inlayphp/two-factor-authentication": "dev-main",
        "inlayphp/validation": "dev-main",
        "inlayphp/widgets": "dev-main",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "php": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-drift": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "deploy": [
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force --seed",
            "@php artisan optimize"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/authorization",
            "options": {
