{
  "name": "inlay-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test:frontend": "pnpm --workspace-concurrency=1 -r --if-present test -- --run",
    "typecheck": "pnpm --workspace-concurrency=1 -r --if-present typecheck && pnpm --dir packages/panel/react exec tsc -p ../../../stubs/react/tsconfig.json",
    "verify": "pnpm build && pnpm typecheck && vendor/bin/pest --compact && pnpm test:frontend",
    "publish:npm": "pnpm -r --filter '@inlayphp/*' publish --access public --no-git-checks",
    "publish:npm:dry-run": "pnpm -r --filter '@inlayphp/*' publish --access public --no-git-checks --dry-run"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<=8.5.22": ">=8.5.23",
      "nanoid@<3.3.17": ">=3.3.17"
    }
  }
}
