{
    "name": "inlayphp/panels",
    "description": "PHP-first administration panels, authentication, dashboards, navigation, and routing for Laravel and Inertia.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0",
        "illuminate/container": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/hashing": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "inertiajs/inertia-laravel": "^3.0",
        "inlayphp/authorization": "dev-main",
        "inlayphp/core": "dev-main",
        "inlayphp/design": "dev-main",
        "inlayphp/forms": "dev-main",
        "inlayphp/support": "dev-main",
        "inlayphp/theme": "dev-main",
        "inlayphp/widgets": "dev-main"
    },
    "suggest": {
        "inlayphp/resources": "Register model-centric CRUD resources directly on a panel."
    },
    "autoload": {
        "psr-4": {
            "Inlay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inlay\\PanelServiceProvider"
            ]
        }
    }
}
