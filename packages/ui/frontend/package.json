{
  "name": "@inlayphp/ui",
  "version": "0.3.4",
  "description": "Renderer-neutral control and button class vocabulary shared by Inlay's React and Vue packages.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InlayPHP/inlay.git",
    "directory": "packages/ui/frontend"
  },
  "homepage": "https://github.com/InlayPHP/inlay/tree/main/packages/ui/frontend",
  "bugs": {
    "url": "https://github.com/InlayPHP/inlay/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
