{
    "name": "inlayphp/authorization-spatie",
    "description": "Spatie Laravel Permission synchronization and super-admin integration for Inlay.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "inlayphp/authorization": "^0.3 || dev-main",
        "spatie/laravel-permission": "^6.0 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Inlay\\AuthorizationSpatie\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inlay\\AuthorizationSpatie\\AuthorizationSpatieServiceProvider"
            ]
        }
    }
}
