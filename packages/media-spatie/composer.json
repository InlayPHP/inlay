{
    "name": "inlayphp/media-spatie",
    "description": "Zero-copy Spatie Media Library bridge for the Inlay media catalog.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "inlayphp/media": "dev-main",
        "spatie/laravel-medialibrary": "^11.23.2"
    },
    "autoload": {
        "psr-4": {
            "Inlay\\MediaSpatie\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inlay\\MediaSpatie\\MediaSpatieServiceProvider"
            ]
        }
    }
}
