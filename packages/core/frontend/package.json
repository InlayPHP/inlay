{
  "name": "@inlayphp/core",
  "version": "0.3.5",
  "description": "Framework-neutral contracts and extension registries for Inlay renderers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/testing/index.ts --format esm --dts --clean",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InlayPHP/inlay.git",
    "directory": "packages/core/frontend"
  },
  "homepage": "https://github.com/InlayPHP/inlay/tree/main/packages/core/frontend",
  "bugs": {
    "url": "https://github.com/InlayPHP/inlay/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
