{
    "name": "inlayphp/tables",
    "description": "Schema-driven tables for Laravel and Inertia.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/container": "^12.0 || ^13.0",
        "inlayphp/actions": "^0.3 || dev-main",
        "inlayphp/schemas": "^0.3 || dev-main",
        "inlayphp/support": "^0.3 || dev-main",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/pagination": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Inlay\\Tables\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inlay\\Tables\\TablesServiceProvider"
            ]
        }
    },
    "suggest": {
        "inlayphp/forms": "Use form schemas in table filters and action modals."
    }
}
