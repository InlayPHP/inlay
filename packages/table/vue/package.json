{
  "name": "@inlayphp/tables-vue",
  "version": "0.3.2",
  "description": "Vue renderer for Inlay PHP-first tables.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist/types",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@inlayphp/actions": "workspace:^",
    "@inlayphp/actions-vue": "workspace:^",
    "@inlayphp/core": "workspace:^",
    "@inlayphp/theme": "workspace:^",
    "@inlayphp/forms-vue": "workspace:^",
    "@inlayphp/ui-vue": "workspace:^",
    "@inertiajs/vue3": "^3.0.0",
    "vue": "^3.4.0",
    "@inlayphp/ui": "workspace:^"
  },
  "devDependencies": {
    "@inlayphp/actions": "workspace:^",
    "@inlayphp/actions-vue": "workspace:^",
    "@inlayphp/core": "workspace:^",
    "@inlayphp/theme": "workspace:^",
    "@inlayphp/forms-vue": "workspace:^",
    "@inlayphp/ui-vue": "workspace:^",
    "@inertiajs/vue3": "^3.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "@inlayphp/ui": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/InlayPHP/inlay.git",
    "directory": "packages/table/vue"
  },
  "homepage": "https://github.com/InlayPHP/inlay/tree/main/packages/table/vue",
  "bugs": {
    "url": "https://github.com/InlayPHP/inlay/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
