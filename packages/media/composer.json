{
    "name": "inlayphp/media",
    "description": "Secure media catalog, albums, folders, and upload domain for Inlay.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/config": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Inlay\\Media\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inlay\\Media\\MediaServiceProvider"
            ]
        }
    }
}
